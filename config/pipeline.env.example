# Containers and ROS 2
ROS_DOMAIN_ID=44
ISAAC_CONTAINER=isaac-sim-5.1.0
ROS_CONTAINER=ros-jazzy-rviz

# Host-side Python environment. Source and models default to paths in this repo.
HOST_PYTHON=/absolute/path/to/graspnet/bin/python
# Optional overrides:
# GRASPNET_DIR=${REPO_ROOT}/third_party/graspnet-baseline
# GRASPNET_RUNNER=${GRASPNET_DIR}/demo.py
# GRASPNET_CHECKPOINT=${REPO_ROOT}/model/graspnet/checkpoint-rs.tar
# YOLOE_WEIGHTS=${REPO_ROOT}/model/yoloe/yoloe-26l-seg.pt
# SAM_WEIGHTS=${REPO_ROOT}/model/sam/sam_b.pt

# Paths visible inside the Isaac Sim container
REPO_ISAAC=/workspace/grasp-pipeline
USD_ISAAC=/workspace/grasp-pipeline/assets/usd/market2_shelf_background_bundle_portable/new_0713_3camera.usd
TCP_EXTRINSIC_ISAAC=/workspace/grasp-pipeline/config/tcp_extrinsic.json

# Scene prims and planned recognition pose
CAMERA_PRIM=/World/Robot/left_link6/left_camera
BASE_X=0.50
BASE_Y=-0.20
BASE_Z=0.315
BASE_YAW=3.141592653589793
LIFT_POSITION=-0.4
